# ---------------------------------------------------------------------------
# Yaqoot ISP Engine — environment example
# Copy to .env.local. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Supabase (Yaqoot ERP project) ----------------------------------------
# The anon key is safe for the browser; RLS + SECURITY DEFINER RPCs guard data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by route handlers to call SECURITY DEFINER RPCs.
# Never expose this to the browser and never log it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Provider session encryption ------------------------------------------
# 32-byte base64 key used to seal provider session material at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ISP_SESSION_SECRET=

# --- Active provider adapters ---------------------------------------------
# Comma-separated adapter keys to register at boot. "mock" needs no credentials.
ISP_ENABLED_ADAPTERS=mock

# --- Mock provider --------------------------------------------------------
# Simulation profile: full | basic | readonly | legacy | ftth | wireless
ISP_MOCK_PROFILE=full
# Deterministic dataset seed.
ISP_MOCK_SEED=1404
# Injected failure rate (0..1) for exercising error/reconciliation paths.
ISP_MOCK_FAILURE_RATE=0

# --- Earthlink adapter ----------------------------------------------------
# INTENTIONALLY BLANK. No official public Earthlink reseller API documentation
# was available when this module was written, so the adapter ships as a
# declared, unimplemented boundary. Fill these in only against real vendor
# documentation — do not invent endpoints.
EARTHLINK_API_BASE_URL=
EARTHLINK_AGENT_ID=
EARTHLINK_API_KEY=
