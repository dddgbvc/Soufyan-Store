{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/telegram/retry",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "app/api/matches/[matchId]/evidence/route.ts": { "maxDuration": 300 },
    "app/api/matches/[matchId]/verify/route.ts": { "maxDuration": 300 }
  }
}
