# =============================================================================
# ERP Authentication & Permissions — environment template
# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local, real keys, service
# role keys or the PIN pepper.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string → "Transaction pooler"
# (port 6543). The auth schema is NOT exposed through the Data API on purpose,
# so the server talks to Postgres directly.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_POOL_SIZE=8
DATABASE_STATEMENT_TIMEOUT_MS=8000

# --- Secrets ----------------------------------------------------------------
# Server-side pepper for PIN hashing and the PIN blind index. Minimum 32 chars.
# Generate with: npm run gen:pepper
# Rotating this invalidates every stored PIN — see docs/security.md.
AUTH_PIN_PEPPER=

# --- Application ------------------------------------------------------------
# Public origin. Must be exact: it is used for the QR payload and the
# same-origin check on every state-changing request.
APP_URL=http://localhost:3000

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=erp_auth_session
CSRF_COOKIE_NAME=erp_auth_csrf
DEVICE_COOKIE_NAME=erp_auth_device
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# --- PIN policy -------------------------------------------------------------
PIN_LENGTH=6
PIN_MAX_ATTEMPTS=5
PIN_ATTEMPT_WINDOW_SECONDS=300
PIN_LOCKOUT_SECONDS=120

# --- OTP (forgot PIN) -------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RESET_TOKEN_TTL_SECONDS=600

# --- QR passkey -------------------------------------------------------------
QR_TTL_SECONDS=120
QR_POLL_INTERVAL_MS=1500

# --- Supabase Auth (email + password login) ---------------------------------
# Optional. Without these, the email + password method is hidden and its API
# returns "unavailable"; PIN and QR login keep working.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed for creating Supabase Auth users from the admin screen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email delivery ---------------------------------------------------------
# console = print a notice to the server log (development only)
# resend  = deliver through Resend
MAIL_PROVIDER=console
MAIL_FROM=ERP Auth <no-reply@example.com>
RESEND_API_KEY=
# Development only: also print the OTP body to the server log.
MAIL_DEBUG_SHOW_BODY=false
